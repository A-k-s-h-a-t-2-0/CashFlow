<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="#172419">

    <!-- Transaction title -->
    <TextView
        android:id="@+id/tvTransactionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lunch"
        android:textColor="#E8F5E9"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Category and date -->
    <TextView
        android:id="@+id/tvTransactionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Food • 2026-10-02"
        android:textColor="#9EAA9F"
        android:textSize="14sp" />

    <!-- Notes -->
    <TextView
        android:id="@+id/tvTransactionNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Had lunch at college"
        android:textColor="#9EAA9F"
        android:textSize="14sp"
        android:maxLines="2" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₹250"
        android:textColor="#A5D6A7"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>